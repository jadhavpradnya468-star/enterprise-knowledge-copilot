APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# SQLite is used by default (backend/storage/app.db). For PostgreSQL + pgvector:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/copilot
# VECTOR_STORE=pgvector
VECTOR_STORE=local            # local | chroma | pgvector

# "fake" = offline deterministic stand-ins (tests/demos only). Use "gemini" for real answers.
LLM_PROVIDER=fake             # fake | gemini
EMBEDDING_PROVIDER=fake       # fake | gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Gemini Developer API ...
GEMINI_API_KEY=
# ... or Vertex AI (set USE_VERTEX=true and rely on Application Default Credentials)
USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: USD per 1M tokens, so cost per request can be estimated. Check current published pricing.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# Access control: "name:key,name2:key2". Generate long random keys; never keep the demo key in production.
API_KEYS=demo:demo-key

STORAGE_BACKEND=local         # local | gcs
GCS_BUCKET=
MAX_UPLOAD_MB=20

TOP_K=5
MIN_SCORE=0.15
MAX_RETRIES=1
